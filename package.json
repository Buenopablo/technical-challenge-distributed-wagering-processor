{
  "name": "jungle-wagering-challenge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "outbox:publish": "bun run src/outbox-publisher.ts",
    "inbox:consume": "bun run src/inbox-consumer.ts",
    "references:process": "bun run src/pending-reference-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run src/database/run-migrations.ts",
    "db:revert": "bun run src/database/revert-migration.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
